  "page_text": {
    "timeline": "<section>\n  <div class=\"sectitle\"><h2>June</h2></div>\n  <div class=\"day\">\n    <div class=\"dayhead\"><h3>Jun 11 &middot; Friday</h3><span class=\"sub\">move-in</span></div>\n    <dl class=\"run\">\n      <dt>3:00pm</dt><dd><strong>Check-in.</strong> Nothing is set up before this.</dd>\n      <dt>Evening</dt><dd>Welcome dinner in the main lodge. S'mores at the fire pit.</dd>\n    </dl>\n  </div>\n  <div class=\"day\">\n    <div class=\"dayhead\"><h3>Jun 12 &middot; Saturday</h3><span class=\"sub\">wedding day &middot; sunset 8:51pm</span></div>\n    <dl class=\"run\">\n      <dt>9:00am</dt><dd>Hair and makeup start.</dd>\n      <dt>4:00pm</dt><dd><strong>Ceremony</strong> on the lawn by the lake.</dd>\n      <dt>4:30&ndash;6:00</dt><dd>Cocktail hour while photos are taken.</dd>\n      <dt>6:00pm</dt><dd>Dinner and toasts.</dd>\n      <dt>8:00pm</dt><dd><strong>First dance</strong>, then dancing until 11.</dd>\n    </dl>\n  </div>\n  <div class=\"day\">\n    <div class=\"dayhead\"><h3>Jun 13 &middot; Sunday</h3><span class=\"sub\">check-out</span></div>\n    <dl class=\"run\">\n      <dt>11:00am</dt><dd><strong>Checkout.</strong> Decor packed, trash out, furniture back.</dd>\n    </dl>\n  </div>\n</section>\n\n<section>\n  <div class=\"sectitle\"><h2>Events</h2></div>\n  <div class=\"tablewrap\">\n    <table>\n      <thead><tr><th>Day</th><th>Time</th><th>Event</th><th>Where</th><th>Items</th></tr></thead>\n      <tbody>\n        <tr><td class=\"mono\">Fri</td><td class=\"mono\">Evening</td><td><strong>Welcome dinner</strong></td><td>Main lodge</td><td>Tablecloths, candles, name cards.</td></tr>\n        <tr><td class=\"mono\">Sat</td><td class=\"mono\">4:00pm</td><td><strong>Ceremony</strong></td><td>Lakeside lawn</td><td>Arch, chairs, aisle flowers, speaker for the trio.</td></tr>\n        <tr><td class=\"mono\">Sat</td><td class=\"mono\">6:00pm</td><td><strong>Dinner</strong></td><td>Tent</td><td>Runners, centrepieces, string lights.</td></tr>\n      </tbody>\n    </table>\n  </div>\n</section>",
    "notes": "<section>\n  <div class=\"sectitle\"><h2>Notes</h2></div>\n  <div class=\"kv\">\n    <div><b>Ceremony chairs: <span data-calc=\"ceremony_chairs\"></span></b> &mdash; guest count (<span data-calc=\"guests\"></span>) + <span data-calc=\"musicians\"></span> for the trio &minus; <span data-calc=\"standing\"></span> standing up front.</div>\n    <div>The lodge has 8 picnic tables seating 8 each.</div>\n  </div>\n</section>"
